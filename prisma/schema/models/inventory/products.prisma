model Product {
    id  Int @id @default(autoincrement())
    name String

    sku String
    price Decimal @db.Decimal(20,2)
    stock Int
    
    category_id Int
    unit_id Int

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt
    
    category Category @relation(fields: [category_id], references: [id])
    unit Unit @relation(fields: [unit_id], references: [id])
    productLocation ProductLocation[]
    stockTransactionProduct StockTransactionProduct[]
    stockOpnameLocation StockOpnameLocation[]

    @@map("products")
}

model ProductLocation {
    id Int @id @default(autoincrement())
    code String
    name String
    notes String? @db.LongText

    product_id Int
    warehouse_id Int
    location_id Int
    rack_id Int

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
    warehouse Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)
    location Location @relation(fields: [location_id], references: [id], onDelete: Cascade)
    rack Rack @relation(fields: [rack_id], references: [id], onDelete: Cascade)

    @@map("product_locations")
}