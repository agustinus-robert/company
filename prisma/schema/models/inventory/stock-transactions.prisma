model StockTransaction{
    id Int @id @default(autoincrement())
    transaction_type TransactionType

    reference_no String
    source String?
    receiver String?
    contact_person String
    phone Int
    note String? @db.LongText

    warehouse_id Int

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    warehouse Warehouse @relation(fields: [warehouse_id], references: [id])
    stockTransactionProduct StockTransactionProduct[]
    
    grand_total Decimal @db.Decimal(20, 2) 

    @@map("stock_transactions")
}

model StockTransactionProduct{
    id Int @id @default(autoincrement())    
    stock_id Int
    product_id Int
    unit_id Int

    qty Int    
    total Decimal @db.Decimal(20, 2) 

    stockTransaction StockTransaction @relation(fields: [stock_id], references: [id])
    product Product @relation(fields: [product_id], references: [id])
    unit Unit @relation(fields: [unit_id], references: [id])
    @@map("stock_transaction_products")
}

enum TransactionType {
    in
    out
}